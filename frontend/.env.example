# URL base de la API del backend.
# Desarrollo local:
VITE_API_URL=http://127.0.0.1:8000/api

# Producción (Railway): esta variable se inyecta en TIEMPO DE BUILD, porque Vite
# "hornea" su valor dentro del bundle. Se declara como variable del servicio de
# frontend en Railway y el Dockerfile la recibe con ARG. Ejemplo:
# VITE_API_URL=https://numbyte-backend.up.railway.app/api
#
# Importante: cada vez que cambie el dominio del backend hay que volver a
# desplegar el frontend para regenerar el bundle.
