# ============================================================
# NUMBYTE API - Variables de entorno
# Copia este archivo como `.env` y ajusta los valores.
# En Railway estas variables se configuran en el panel del servicio.
# ============================================================

APP_NOMBRE=NUMBYTE API
# desarrollo | produccion
APP_AMBIENTE=desarrollo
# Clave para firmar los JWT. CAMBIAR en producción por una cadena larga y aleatoria.
APP_LLAVE_SECRETA=NUMBYTE_LLAVE_SEGURA_2026_CAMBIAR_EN_PRODUCCION
APP_ALGORITMO_JWT=HS256
APP_EXPIRACION_TOKEN_MINUTOS=1440

# --- Base de datos ---
# Desarrollo local (por defecto): SQLite.
APP_URL_BD=sqlite:///./numbyte.db
# Producción (Railway): el plugin de PostgreSQL inyecta DATABASE_URL
# automáticamente; NO hay que escribirla a mano. Si se define, tiene
# prioridad sobre APP_URL_BD.
# DATABASE_URL=postgresql://usuario:clave@host:5432/basedatos

# --- CORS ---
# Orígenes permitidos separados por coma. En producción usa el dominio del
# frontend desplegado, por ejemplo: https://numbyte-frontend.up.railway.app
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend / enlaces de correo ---
# URL pública del frontend (se usa para construir los enlaces de los correos).
APP_URL_FRONTEND=http://127.0.0.1:5173
APP_EXPIRACION_RESET_MINUTOS=30

# --- Envío de correo ---
# CORREO_MODO=simulado  -> guarda el correo en backend/correos_simulados y en consola (demo).
# CORREO_MODO=smtp      -> envía correo real usando los datos SMTP de abajo.
CORREO_MODO=simulado
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=NUMBYTE <no-responder@numbyte.local>
SMTP_USAR_TLS=true
